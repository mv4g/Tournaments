# Public Supabase project URL and anon key (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_DISCORD_IDS=discord_user_id_1,discord_user_id_2

# Configure Discord OAuth in Supabase Dashboard > Authentication > Providers > Discord.
# Set the Discord Client ID/Secret in Supabase, not in this file or client code.
